{
  "private": true,
  "type": "module",
  "name": "empty-template-project",
  "version": "1.2.0",
  "description": "Repo Template: parcel, mocha-chai, eslint.",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "browserslist": [
    "baseline 2025"
  ],
  "prettier": "@epreston/prettier-config",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "clean": "rimraf -g -v dist/*",
    "start": "parcel serve ./src/index.html",
    "build": "rimraf -g dist/* && parcel build ./src/index.html",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.?(c|m)[tj]s\"",
    "test": "mocha"
  },
  "devDependencies": {
    "@epreston/eslint-config": "^2.4.2",
    "@epreston/prettier-config": "^2.1.1",
    "@epreston/tsconfig": "^1.2.2",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "mocha": "^12.0.3",
    "parcel": "^2.16.4",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "lmdb": true,
    "msgpackr-extract": true
  }
}
